server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;

  # go_router deep links: fall back to index.html so /route/x doesn't 404 on refresh.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Never cache the Flutter entry points — filenames don't change between
  # builds but they load the hashed main.dart.js. Caching them pins users
  # to the old build after a deploy.
  location = /index.html {
    add_header Cache-Control "no-store";
  }
  location = /flutter_bootstrap.js {
    add_header Cache-Control "no-store";
  }
  location = /flutter_service_worker.js {
    add_header Cache-Control "no-store";
  }
  location = /manifest.json {
    add_header Cache-Control "no-store";
  }

  # Flutter's own bundle already hashes filenames of the code chunks (main.dart.js,
  # canvaskit, etc.) so those get long TTLs. Manually-authored assets (fonts,
  # images, audio) keep stable paths — cache 1h with must-revalidate so a new
  # deploy replaces them within the hour instead of after 30 days.
  location ~* ^/(assets|icons)/ {
    add_header Cache-Control "public, max-age=3600, must-revalidate";
  }

  # Everything else (hashed Flutter chunks) — cache hard.
  location ~* \.(?:js|css|woff2?|ttf)$ {
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
  }
}
